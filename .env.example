# ============================================================
# VRChat Agent 环境变量模板
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 排除，
# 切勿把密钥提交到版本库。API keys 一律走 .env，不写入 config.yaml。
# ============================================================

# 云端 LLM（OpenAI 兼容协议）——必填（本地 Ollama/vLLM 可留空）
LLM_API_KEY=sk-xxxxx

# 云端 TTS 供应商 key——provider=cloud 时必填
TTS_API_KEY=sk-xxxxx

# 小米 MiMo 克隆 TTS key——provider=mimo 时必填（MiMo-V2.5-TTS-VoiceClone）
MIMO_TTS_API_KEY=sk-xxxxx

# OBS WebSocket 密码（若 OBS 启用了密码）
OBS_PASSWORD=

# VRChat API 集成（任务①：换头像/查好友/找世界/更新状态）
# 用 VRChat 账号的用户名密码登录（推荐）；也可用 API key（VRC_API_KEY，可选）
VRC_USERNAME=your_vrchat_username
VRC_PASSWORD=your_vrchat_password
# VRC_API_KEY=vrchat-api-key-optional

# 可选：覆盖 config.yaml 中的 LLM 端点/模型
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
