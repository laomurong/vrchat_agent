classDiagram
    class UtteranceState {
        <<enumeration>>
        RECEIVED
        LLM_RUNNING
        LLM_DONE
        TTS_RUNNING
        TTS_DONE
        PLAYING
        DONE
        CANCELLED
    }

    class Utterance {
        +int id
        +str text
        +UtteranceState state
        +Decision? decision
        +AudioClip? clip
        +list~Action~ actions
        +list~Action~ chatbox_actions
        +Event cancel_event
        +str? vision_b64
        +float created_at
        +float latency_s
    }

    class OutputSlot {
        -AudioOutput _audio_out
        -Actuator _actuator
        -EventBus _bus
        -Queue _queue
        -Lock _lock
        -Utterance? _current
        -str _backlog_strategy
        -int _max_queue
        +enqueue(utt: Utterance) None
        +run() None
        +interrupt_current() None
        +clear() None
        +current() Utterance?
        +queue_size() int
    }

    class PipelineCoordinator {
        -Brain _brain
        -TTSEngine _tts
        -OutputSlot _output_slot
        -EventBus _bus
        -Semaphore _llm_sem
        -Semaphore _tts_sem
        -dict _active: dict~int, Utterance~
        -int _next_id
        +submit(text: str) Utterance
        +cancel_utterance(utt_id: int) bool
        +cancel_all() None
        +active_utterances() dict
        -_run_pipeline(utt: Utterance) None
    }

    class AgentLoop {
        -PipelineCoordinator _pipeline
        -OutputSlot _output_slot
        -AgentState _state
        -EventBus _bus
        +run() None
        -_on_utterance(event: Event) None
        -_on_emergency(event: Event) None
    }

    class InterruptController {
        +request_interrupt(target_utt_id: int?) None
        +cancel_utterance(utt_id: int) None
        +clear() None
    }

    class Brain {
        +decide(utterance: str, vision: str?) Decision
    }

    class TTSEngine {
        <<abstract>>
        +synthesize(text: str, emotion: str?) AudioClip
    }

    class AudioOutput {
        +play(clip: AudioClip) None
        +stop() None
    }

    class Actuator {
        <<abstract>>
        +execute(action: Action) None
        +reset() None
    }

    AgentLoop --> PipelineCoordinator : 提交/取消
    AgentLoop --> OutputSlot : 输出
    PipelineCoordinator --> OutputSlot : enqueue
    PipelineCoordinator --> Utterance : 创建/追踪
    PipelineCoordinator --> Brain : decide
    PipelineCoordinator --> TTSEngine : synthesize
    OutputSlot --> Utterance : 播放
    OutputSlot --> AudioOutput : play/stop
    OutputSlot --> Actuator : execute
    InterruptController --> PipelineCoordinator : per-utt cancel
    InterruptController --> OutputSlot : interrupt_current
